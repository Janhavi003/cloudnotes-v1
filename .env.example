# PostgreSQL connection string used by CloudNotes.
# Create a real environment file on the Linux server.
# NEVER commit the real .env file to Git.

DATABASE_URL=postgresql://cloudnotes_user:CHANGE_THIS_PASSWORD@localhost:5432/cloudnotes

# Flask application secret.
# Replace this with a long, random value on the server.
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET
