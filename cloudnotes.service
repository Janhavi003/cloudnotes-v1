[Unit]
Description=CloudNotes Flask application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cloudnotes
Group=cloudnotes
WorkingDirectory=/opt/cloudnotes
EnvironmentFile=/etc/cloudnotes/cloudnotes.env
ExecStart=/opt/cloudnotes/venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
